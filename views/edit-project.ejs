<%- include('partials/header', { title: title }) %>

<main class="container">
    <h1>Edit Service Project</h1>

    <% if (errors && errors.length > 0) { %>
        <ul class="error-list" role="alert">
            <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="/edit-project/<%= project.project_id %>" method="POST">
        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= project.title %>"
                required
                maxlength="150"
            />
        </div>

        <div class="form-group">
            <label for="organization_id">Organization</label>
            <select id="organization_id" name="organization_id" required>
                <option value="">Select an organization</option>
                <% organizations.forEach(org => { %>
                    <option
                        value="<%= org.organization_id %>"
                        <%= String(project.organization_id) === String(org.organization_id) ? 'selected' : '' %>
                    >
                        <%= org.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= project.location %>"
                required
                maxlength="150"
            />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= project.date %>"
                required
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                rows="5"
                required
                maxlength="2000"
            ><%= project.description %></textarea>
        </div>

        <% if (categories && categories.length > 0) { %>
            <fieldset class="form-group">
                <legend>Categories</legend>
                <% categories.forEach(category => { %>
                    <label class="checkbox-label">
                        <input
                            type="checkbox"
                            name="category_ids"
                            value="<%= category.category_id %>"
                            <%= selectedCategoryIds && selectedCategoryIds.includes(Number(category.category_id)) ? 'checked' : '' %>
                        />
                        <%= category.name %>
                    </label>
                <% }) %>
            </fieldset>
        <% } %>

        <button type="submit">Save Project Changes</button>
    </form>

    <p><a href="/project/<%= project.project_id %>">Back to Project Details</a> | <a href="/projects">All Projects</a></p>
</main>

<%- include('partials/footer') %>