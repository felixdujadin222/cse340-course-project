<%- include('partials/header', { title: title }) %>

<main class="container">
    <h1>Service Projects</h1>
    <p>Discover our ongoing and upcoming service projects designed to support those in need.</p>
    
    <ul class="project-list" style="list-style: none; padding: 0; margin-top: 1.5rem;">
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <li style="background: #ffffff; padding: 1.5rem; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 1rem;">
                    <h3>
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    </h3>
                    <p><%= project.description %></p>
                    <p><strong>Location:</strong> <%= project.location %></p>
                    <p><strong>Date:</strong> <%= project.date %></p>
                    <p class="organization-link">
                        <strong>Organization:</strong> 
                        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                    </p>
                </li>
            <% }) %>
        <% } else { %>
            <p>No service projects available at this time.</p>
        <% } %>
    </ul>
</main>

<%- include('partials/footer') %>