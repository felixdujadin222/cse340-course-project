<%- include('partials/header', { title: title }) %>

<main class="container">
    <h1>Edit Organization</h1>

    <% if (errors && errors.length > 0) { %>
        <ul class="error-list" role="alert">
            <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="/edit-organization/<%= organization.organization_id %>" method="POST">
        <div class="form-group">
            <label for="name">Organization Name</label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= organization.name %>"
                required
                maxlength="150"
            />
        </div>

        <div class="form-group">
            <label for="contact_email">Contact Email</label>
            <input
                type="email"
                id="contact_email"
                name="contact_email"
                value="<%= organization.contact_email %>"
                required
                maxlength="150"
            />
        </div>

        <div class="form-group">
            <label for="logo_filename">Logo Filename (optional)</label>
            <input
                type="text"
                id="logo_filename"
                name="logo_filename"
                value="<%= organization.logo_filename || '' %>"
                maxlength="150"
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                rows="5"
                required
                maxlength="2000"
            ><%= organization.description %></textarea>
        </div>

        <button type="submit">Save Organization Changes</button>
    </form>

    <p><a href="/organization/<%= organization.organization_id %>">Back to Organization Details</a> | <a href="/organizations">All Organizations</a></p>
</main>

<%- include('partials/footer') %>