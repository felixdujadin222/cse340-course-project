<%- include('partials/header', { title: title }) %>

<main class="container">
    <h1><%= organization.name %></h1>

    <% if (organization.logo_filename) { %>
        <img
            src="/images/<%= organization.logo_filename %>"
            alt="<%= organization.name %> logo"
            width="120"
            height="120"
            style="height: auto;"
        />
    <% } %>

    <p><%= organization.description %></p>

    <% if (organization.contact_email) { %>
        <p><strong>Contact:</strong> <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a></p>
    <% } %>

    <h2>Service Projects</h2>
    <% if (projects && projects.length > 0) { %>
        <ul style="list-style: none; padding-left: 0; display: flex; flex-direction: column; gap: 0.5rem;">
            <% projects.forEach(project => { %>
                <li>
                    <a
                        href="/project/<%= project.project_id %>"
                        style="display: inline-flex; align-items: center; min-height: 44px; padding: 0.5rem 0.75rem;"
                    ><%= project.title %></a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No service projects listed for this organization yet.</p>
    <% } %>

    <p style="margin-top: 1.5rem;"><a href="/organizations">Back to Organizations</a></p>
</main>

<%- include('partials/footer') %>