<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/header', { title: title }) %>
</head>
<body>
  <main class="container">
    <h1>Partner Organizations</h1>
    <p>We work closely with these amazing community organizations to drive impactful service projects:</p>
    
    <div class="org-grid">
      <!-- Organization 1 -->
      <div class="org-card">
        <img src="/images/community-action.jpg" alt="Volunteers working with Community Action Network" />
        <div class="org-content">
          <h3>Community Action Network</h3>
          <p>Focused on local educational outreach, youth mentoring, and neighborhood development programs.</p>
        </div>
      </div>

      <!-- Organization 2 -->
      <div class="org-card">
        <img src="/images/green-earth.jpg" alt="Green Earth Initiative park clean-up" />
        <div class="org-content">
          <h3>Green Earth Initiative</h3>
          <p>Dedicated to environmental conservation, community tree planting, and recycling awareness drives.</p>
        </div>
      </div>

      <!-- Organization 3 -->
      <div class="org-card">
        <img src="/images/food-bank.jpg" alt="Volunteers organizing food boxes at the food bank" />
        <div class="org-content">
          <h3>Community Food Bank</h3>
          <p>Providing essential food assistance, nutritional resources, and emergency relief to families in need.</p>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>